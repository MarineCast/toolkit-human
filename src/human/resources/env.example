# Local run defaults. Copy to .env; preserve existing values/secrets.
# Arguments override process environment, then this file, then recipe defaults.
# File-relative DATA_DIR resolves beside .env. Dates are inclusive local civil dates.
DATA_DIR=../../Data/Human/
START_DATE=2009-01-01
END_DATE=2026-12-31
VERBOSITY=True

# Dates select calendar output only. Census remains US 2020 / Canada 2021.
# A run publishes all three products transactionally; no weather-style append/REBUILD setting.
